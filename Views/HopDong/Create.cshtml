@model QuanLyKTX.Models.HopDong
@{ ViewData["Title"] = "Lập hợp đồng mới"; }

<div class="card-panel form-card reveal-up d1">
    <div class="card-core">
        <h5 class="fw-bold mb-4">Lập hợp đồng mới</h5>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Phòng</label>
                    <select asp-for="MaPhong" asp-items="ViewBag.DanhSachPhong" class="form-select">
                        <option value="">-- Chọn phòng còn trống --</option>
                    </select>
                    <span asp-validation-for="MaPhong" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Người thuê</label>
                    <select asp-for="MaNguoiThue" asp-items="ViewBag.DanhSachNguoiThue" class="form-select">
                        <option value="">-- Chọn người thuê --</option>
                    </select>
                    <span asp-validation-for="MaNguoiThue" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NgayBatDau" class="form-label">Ngày bắt đầu</label>
                    <input asp-for="NgayBatDau" type="date" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="NgayKetThuc" class="form-label">Ngày kết thúc (dự kiến)</label>
                    <input asp-for="NgayKetThuc" type="date" class="form-control" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TienCoc" class="form-label">Tiền cọc (đ)</label>
                    <input asp-for="TienCoc" type="number" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn-accent">
                    Lập hợp đồng
                    <span class="icon-chip"><i class="bi bi-check-lg"></i></span>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>