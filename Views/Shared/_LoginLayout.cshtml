@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Quản Lý Ký Túc Xá</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Manrope', sans-serif; box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            background: #0d0d16;
            overflow: hidden;
        }

        .login-visual {
            flex: 1.15;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 64px;
            color: #fff;
            overflow: hidden;
            background: #0d0d16;
        }

        .grid-bg {
            position: absolute;
            inset: -50px;
            background-image: radial-gradient(rgba(255,255,255,0.09) 1px, transparent 1px);
            background-size: 28px 28px;
            animation: gridDrift 40s linear infinite;
        }
        @@keyframes gridDrift {
            0% { transform: translate(0, 0); }
            100% { transform: translate(-28px, -28px); }
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(70px);
            opacity: 0.45;
            pointer-events: none;
        }
        .blob-1 {
            width: 420px; height: 420px;
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            top: -100px; left: -80px;
            animation: floatSlow 14s ease-in-out infinite;
        }
        .blob-2 {
            width: 320px; height: 320px;
            background: linear-gradient(135deg, #00d9a5, #00b8d9);
            bottom: -80px; right: -60px;
            animation: floatSlow 18s ease-in-out infinite reverse;
        }
        .blob-3 {
            width: 220px; height: 220px;
            background: linear-gradient(135deg, #ff7bb0, #6c5ce7);
            bottom: 30%; left: 45%;
            opacity: 0.25;
            animation: floatSlow 22s ease-in-out infinite;
        }
        @@keyframes floatSlow {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -40px) scale(1.08); }
            66% { transform: translate(-25px, 25px) scale(0.95); }
        }

        .visual-content { position: relative; z-index: 2; }

        .mark {
            width: 60px; height: 60px;
            border-radius: 16px;
            background: linear-gradient(135deg, #6c5ce7, #00d9a5);
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; margin-bottom: 36px;
            box-shadow: 0 12px 32px rgba(108,92,231,0.35);
            animation: markPulse 4s ease-in-out infinite;
        }
        @@keyframes markPulse {
            0%, 100% { box-shadow: 0 12px 32px rgba(108,92,231,0.35); }
            50% { box-shadow: 0 12px 44px rgba(0,217,165,0.4); }
        }

        .visual-content h1 {
            font-weight: 800;
            font-size: 36px;
            line-height: 1.28;
            max-width: 440px;
            margin-bottom: 16px;
            opacity: 0;
            animation: fadeUp 0.8s ease 0.15s forwards;
        }
        .visual-content p {
            color: rgba(255,255,255,0.55);
            font-size: 15px;
            max-width: 380px;
            opacity: 0;
            animation: fadeUp 0.8s ease 0.3s forwards;
        }
        .visual-stats {
            display: flex; gap: 28px; margin-top: 40px;
            opacity: 0;
            animation: fadeUp 0.8s ease 0.45s forwards;
        }
        .visual-stats div strong { display: block; font-size: 22px; font-weight: 800; }
        .visual-stats div span { font-size: 12.5px; color: rgba(255,255,255,0.45); }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(14px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-panel {
            flex: 1;
            background: #f4f4f8;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }
        .login-card {
            width: 100%;
            max-width: 380px;
            background: #fff;
            border-radius: 22px;
            padding: 42px 38px;
            box-shadow: 0 24px 70px rgba(20,20,31,0.10);
            opacity: 0;
            transform: translateY(18px);
            animation: cardIn 0.6s cubic-bezier(.22,1,.36,1) 0.1s forwards;
        }
        @@keyframes cardIn {
            to { opacity: 1; transform: translateY(0); }
        }

        .login-card h4 { font-weight: 800; margin-bottom: 4px; font-size: 22px; }
        .login-card .sub { color: #6b6b7b; font-size: 14px; margin-bottom: 30px; }

        .form-label { font-weight: 700; font-size: 13.5px; margin-bottom: 6px; display: block; }
        .input-wrap { position: relative; margin-bottom: 18px; }
        .input-wrap i {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: #a0a0b0; font-size: 15px; transition: color 0.2s;
        }
        .form-control {
            border-radius: 11px;
            border: 1.5px solid #e6e6ee;
            padding: 12px 14px 12px 40px;
            width: 100%;
            font-size: 14.5px;
            transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
        }
        .form-control:focus {
            outline: none;
            border-color: #6c5ce7;
            box-shadow: 0 0 0 4px rgba(108,92,231,0.13);
            transform: translateY(-1px);
        }
        .input-wrap:focus-within i { color: #6c5ce7; }

        .form-check { display: flex; align-items: center; gap: 8px; margin-bottom: 26px; }
        .form-check input { accent-color: #6c5ce7; width: 15px; height: 15px; }
        .form-check label { font-size: 13.5px; color: #444; cursor: pointer; }

        .btn-login {
            background: linear-gradient(135deg, #6c5ce7, #7d6ff0);
            border: none;
            color: #fff;
            font-weight: 700;
            font-size: 15px;
            border-radius: 11px;
            padding: 13px;
            width: 100%;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.2s, filter 0.2s;
            box-shadow: 0 10px 24px rgba(108,92,231,0.28);
        }
        .btn-login:hover {
            transform: translateY(-2px);
            filter: brightness(1.06);
            box-shadow: 0 14px 30px rgba(108,92,231,0.36);
        }
        .btn-login:active { transform: translateY(0); }

        .alert-danger {
            background: #fdeded;
            border: 1px solid #f6c6c6;
            color: #c0392b;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13.5px;
            margin-bottom: 18px;
        }
.particle-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
}

.visual-overlay {
    position: absolute;
    top: 30px;
    left: 34px;
    z-index: 2;
    pointer-events: none;
}

.mark-mini {
    width: 46px; height: 46px;
    border-radius: 13px;
    background: linear-gradient(135deg, #6c5ce7, #00d9a5);
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 11px; color: #fff;
    margin-bottom: 14px;
    box-shadow: 0 10px 26px rgba(108,92,231,0.35);
    }

    .visual-caption {
        color: rgba(255,255,255,0.55);
        font-size: 13.5px;
        max-width: 240px;
        line-height: 1.5;
    }
        @@media (max-width: 900px) {
            .login-visual { display: none; }
        }
    </style>
</head>
<body>
    @RenderBody()
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
