<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Ký Túc Xá</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-mark">KTX</div>
                <div>
                    <div class="brand-title">Quản Lý</div>
                    <div class="brand-sub">Ký Túc Xá</div>
                </div>
            </div>
            <nav class="sidebar-nav glow-nav">
                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(99,102,241,.35) 0%,rgba(99,102,241,.12) 50%,transparent 100%);" asp-controller="Home" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-grid-1x2-fill" style="color:#818cf8"></i> Tổng quan</span>
                        <span class="flip-face flip-back"><i class="bi bi-grid-1x2-fill" style="color:#818cf8"></i> Tổng quan</span>
                    </span>
                </a>

                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Phong" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(108,92,231,.35) 0%,rgba(108,92,231,.12) 50%,transparent 100%);" asp-controller="Phong" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-door-closed-fill" style="color:#a78bfa"></i> Phòng</span>
                        <span class="flip-face flip-back"><i class="bi bi-door-closed-fill" style="color:#a78bfa"></i> Phòng</span>
                    </span>
                </a>

                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "NguoiThue" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(249,115,22,.35) 0%,rgba(249,115,22,.12) 50%,transparent 100%);" asp-controller="NguoiThue" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-people-fill" style="color:#fb923c"></i> Người thuê</span>
                        <span class="flip-face flip-back"><i class="bi bi-people-fill" style="color:#fb923c"></i> Người thuê</span>
                    </span>
                </a>

                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HopDong" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(34,197,94,.35) 0%,rgba(34,197,94,.12) 50%,transparent 100%);" asp-controller="HopDong" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-file-earmark-text-fill" style="color:#4ade80"></i> Hợp đồng</span>
                        <span class="flip-face flip-back"><i class="bi bi-file-earmark-text-fill" style="color:#4ade80"></i> Hợp đồng</span>
                    </span>
                </a>

                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DienNuoc" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(234,179,8,.35) 0%,rgba(234,179,8,.12) 50%,transparent 100%);" asp-controller="DienNuoc" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-lightning-charge-fill" style="color:#facc15"></i> Điện nước</span>
                        <span class="flip-face flip-back"><i class="bi bi-lightning-charge-fill" style="color:#facc15"></i> Điện nước</span>
                    </span>
                </a>

                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HoaDon" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(0,217,165,.35) 0%,rgba(0,217,165,.12) 50%,transparent 100%);" asp-controller="HoaDon" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-receipt" style="color:#2dd4bf"></i> Hóa đơn</span>
                        <span class="flip-face flip-back"><i class="bi bi-receipt" style="color:#2dd4bf"></i> Hóa đơn</span>
                    </span>
                </a>

                <a class="glow-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ThongKe" ? "active" : "")" style="--glow:radial-gradient(circle,rgba(239,68,68,.35) 0%,rgba(239,68,68,.12) 50%,transparent 100%);" asp-controller="ThongKe" asp-action="Index">
                    <span class="glow-bg"></span>
                    <span class="flip-wrap">
                        <span class="flip-face flip-front"><i class="bi bi-bar-chart-fill" style="color:#f87171"></i> Thống kê</span>
                        <span class="flip-face flip-back"><i class="bi bi-bar-chart-fill" style="color:#f87171"></i> Thống kê</span>
                    </span>
                </a>
            </nav>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-user d-flex align-items-center gap-3">
                    <span><i class="bi bi-person-circle"></i> @(User.FindFirst("HoTen")?.Value ?? User.Identity?.Name)</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <main class="content">
                @if (TempData["ThanhCong"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThanhCong"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Loi"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Loi"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
