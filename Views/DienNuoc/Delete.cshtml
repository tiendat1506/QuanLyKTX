@model QuanLyKTX.Models.ChiSoDienNuoc
@{ ViewData["Title"] = "Xóa chỉ số"; }

<div class="card-panel form-card reveal-up d1">
    <div class="card-core">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="stat-icon" style="background:linear-gradient(135deg,#c0392b,#f87171);"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div>
                <h5 class="fw-bold mb-0">Xác nhận xóa chỉ số</h5>
                <div class="text-muted">Hành động này không thể hoàn tác</div>
            </div>
        </div>

        <p>Xóa chỉ số điện nước phòng <strong>@Model.Phong?.TenPhong</strong> — tháng @Model.Thang/@Model.Nam?</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="MaChiSo" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4 rounded-pill fw-bold">Xóa</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>