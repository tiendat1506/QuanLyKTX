@{
    ViewData["Title"] = "Tạo hóa đơn hàng loạt";
}

<div class="card-panel form-card reveal-up d1">
    <div class="card-core">
        <h5 class="fw-bold mb-2">Tạo hóa đơn hàng loạt</h5>
        <p class="text-muted small mb-4">
            Hệ thống sẽ tự động tạo hóa đơn cho mọi hợp đồng đang hiệu lực có đủ dữ liệu chỉ số điện nước của tháng được chọn.
            Tiền điện/nước được tính theo bậc thang, tiền phòng lấy theo đơn giá phòng hiện tại.
        </p>

        <form asp-action="TaoHangLoat" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Tháng</label>
                    <select name="thang" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == DateTime.Today.Month)">Tháng @i</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Năm</label>
                    <input type="number" name="nam" value="@DateTime.Today.Year" class="form-control" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn-accent">
                    Tạo hóa đơn
                    <span class="icon-chip"><i class="bi bi-lightning-fill"></i></span>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>