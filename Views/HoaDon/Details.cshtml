@model QuanLyKTX.Models.HoaDon
@{ ViewData["Title"] = "Chi tiết hóa đơn"; }

<div class="card-panel form-card reveal-up d1">
    <div class="card-core">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h4 class="fw-bold mb-1">Hóa đơn tháng @Model.Thang/@Model.Nam</h4>
                <div class="text-muted">Phòng @Model.HopDong?.Phong?.TenPhong — @Model.HopDong?.NguoiThue?.HoTen</div>
            </div>
            @{
                var (cls, text) = Model.TrangThai switch
                {
                    QuanLyKTX.Models.TrangThaiHoaDon.DaThanhToan => ("badge-trong", "Đã thanh toán"),
                    QuanLyKTX.Models.TrangThaiHoaDon.QuaHan => ("badge-baotri", "Quá hạn"),
                    _ => ("badge-daday", "Chưa thanh toán")
                };
            }
            <span class="badge-soft @cls">@text</span>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-5 text-muted">Tiền phòng</dt>
            <dd class="col-sm-7">@Model.TienPhong.ToString("N0") đ</dd>

            <dt class="col-sm-5 text-muted">Tiền điện</dt>
            <dd class="col-sm-7">@Model.TienDien.ToString("N0") đ</dd>

            <dt class="col-sm-5 text-muted">Tiền nước</dt>
            <dd class="col-sm-7">@Model.TienNuoc.ToString("N0") đ</dd>

            <dt class="col-sm-5 text-muted">Chi phí khác</dt>
            <dd class="col-sm-7">@Model.TienKhac.ToString("N0") đ</dd>

            <dt class="col-sm-5 text-muted fw-bold">Tổng cộng</dt>
            <dd class="col-sm-7 fw-bold" style="font-size:18px;">@Model.TongTien.ToString("N0") đ</dd>

            <dt class="col-sm-5 text-muted">Hạn thanh toán</dt>
            <dd class="col-sm-7">@Model.HanThanhToan.ToString("dd/MM/yyyy")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            @if (Model.TrangThai != QuanLyKTX.Models.TrangThaiHoaDon.DaThanhToan)
            {
                <form asp-action="DanhDauDaThanhToan" asp-route-id="@Model.MaHoaDon" method="post" class="m-0">
                    <button type="submit" class="btn-accent">
                        Đánh dấu đã thanh toán
                        <span class="icon-chip"><i class="bi bi-check-lg"></i></span>
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
        </div>
    </div>
</div>