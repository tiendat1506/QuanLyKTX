@model QuanLyKTX.Models.Phong
@{ ViewData["Title"] = "Thêm phòng mới"; }

<div class="card-panel form-card">
    <h5 class="fw-bold mb-4">Thêm phòng mới</h5>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="TenPhong" class="form-label">Tên phòng</label>
                <input asp-for="TenPhong" class="form-control" placeholder="VD: P101" />
                <span asp-validation-for="TenPhong" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Khu" class="form-label">Khu / Tòa nhà</label>
                <input asp-for="Khu" class="form-control" placeholder="VD: Khu A" />
            </div>
            <div class="col-md-6">
                <label asp-for="Tang" class="form-label">Tầng</label>
                <input asp-for="Tang" type="number" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="LoaiPhong" class="form-label">Loại phòng</label>
                <input asp-for="LoaiPhong" class="form-control" placeholder="VD: Phòng 4 người" />
            </div>
            <div class="col-md-6">
                <label asp-for="SucChua" class="form-label">Sức chứa (người)</label>
                <input asp-for="SucChua" type="number" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="DienTich" class="form-label">Diện tích (m²)</label>
                <input asp-for="DienTich" type="number" step="0.1" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="GiaPhong" class="form-label">Giá phòng / tháng (đ)</label>
                <input asp-for="GiaPhong" type="number" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-select" asp-items="Html.GetEnumSelectList<QuanLyKTX.Models.TrangThaiPhong>()"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="NgayDuaVaoSuDung" class="form-label">Ngày đưa vào sử dụng</label>
                <input asp-for="NgayDuaVaoSuDung" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4">Lưu phòng</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
        </div>
    </form>
</div>
