@model QuanLyKTX.Models.NguoiThue
@{ ViewData["Title"] = "Chi tiết người thuê"; }

<div class="card-panel form-card reveal-up d1">
    <div class="card-core">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="stat-icon" style="background:linear-gradient(135deg,#fb923c,#f97316);"><i class="bi bi-person-fill"></i></div>
            <div>
                <h4 class="fw-bold mb-0">@Model.HoTen</h4>
                <div class="text-muted">@Model.CCCD</div>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Giới tính</dt>
            <dd class="col-sm-8">@(Model.GioiTinh ?? "—")</dd>

            <dt class="col-sm-4 text-muted">Ngày sinh</dt>
            <dd class="col-sm-8">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</dd>

            <dt class="col-sm-4 text-muted">Số điện thoại</dt>
            <dd class="col-sm-8">@Model.SDT</dd>

            <dt class="col-sm-4 text-muted">Email</dt>
            <dd class="col-sm-8">@(Model.Email ?? "—")</dd>

            <dt class="col-sm-4 text-muted">Quê quán</dt>
            <dd class="col-sm-8">@(Model.QueQuan ?? "—")</dd>
        </dl>

        <div class="mt-4 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaNguoiThue" class="btn-accent">
                Sửa thông tin
                <span class="icon-chip"><i class="bi bi-pencil"></i></span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
        </div>
    </div>
</div>